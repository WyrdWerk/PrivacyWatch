# Optional local-only overrides for emergency ops scripts (copy to .env, gitignored).
# Not required for normal development or Cloudflare Git deploys.

# Logo.dev publishable key (pk_…) — used only by `npm run logos` to refresh assets/logos/.
# Not embedded in the site. Never commit the key.
# LOGO_DEV_PUBLISHABLE_KEY=

# Legacy redirect deploy (npm run deploy:legacy-redirect) — requires local wrangler login
LEGACY_PAGES_PROJECT=

# PRIVACYWATCH_URL=https://privacywatch.wyrdwerk.com
# PAGES_DEV_HOST=privacywatch.pages.dev

# Bulk redirect script (npm run setup:bulk-redirect) — optional, prefer Cloudflare dashboard
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
